# Copy this file to .env (cp .env.example .env) and fill in real values.
# .env is git-ignored: never commit real keys or passwords.

# dev | test | prod
APP_ENV=dev

# Supabase Postgres.
SUPABASE_URL=
SUPABASE_KEY=
# LLM provider keys go here once the gateway calls a provider.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Standard port for Ollama: 11434
# Use http://host.docker.internal:11434 if the backend runs in Docker.
OLLAMA_BASE_URL=http://localhost:11434