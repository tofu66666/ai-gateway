# Copy this file to .env (cp .env.example .env) and fill in real values.
# .env is git-ignored: never commit real keys or passwords.

# dev | test | prod
APP_ENV=dev

# Supabase Postgres. Use the Session pooler connection string from the
# Supabase dashboard (Connect); the direct connection is IPv6-only and
# usually fails from Docker. Ask Alex for the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# LLM provider keys go here once the gateway calls a provider.
